    "completion_history": 0.96,
    "counterparty_diversity": 0.84,
    "economic_significance": 0.72,
    "volatility": 0.08,
    "uncertainty": 0.14,
    "composed_readiness": null
  }
}{
  "protocol_invariants": [
    "observable_evidence_over_assumption",
    "deterministic_execution",
    "replayable_history",
    "cryptographic_integrity",
    "context_without_prejudice",
    "irreversible_actions_require_sufficient_readiness",
    "every_decision_must_be_explainable"
  ]
}