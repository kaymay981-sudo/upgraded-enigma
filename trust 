# NEXT-GEN DECENTRALIZED ESCROW SYSTEM

## ARCHITECTURAL FRAMEWORK

### Core Smart Contract Structure

```solidity
// SPDX-License-Identifier: MIT
pragma solidity ^0.8.19;

import "@openzeppelin/contracts/security/ReentrancyGuard.sol";
import "@openzeppelin/contracts/access/AccessControl.sol";
import "@chainlink/contracts/src/v0.8/interfaces/AggregatorV3Interface.sol";

contract TrustBridge is ReentrancyGuard, AccessControl {
    
    bytes32 public constant ARBITER_ROLE = keccak256("ARBITER_ROLE");
    bytes32 public constant ORACLE_ROLE = keccak256("ORACLE_ROLE");
    
    enum EscrowState { CREATED, FUNDED, DELIVERED, DISPUTED, RESOLVED, CANCELLED }
    enum ProofType { PHOTO, VIDEO, GPS, TIMESTAMP, SIGNATURE, BIOMETRIC }
    
    struct Proof {
        bytes32 contentHash;      // IPFS hash
        ProofType proofType;
        uint256 timestamp;
        address submitter;
        bool verified;
    }
    
    struct Escrow {
        address buyer;
        address seller;
        uint256 amount;
        uint256 createdAt;
        uint256 deadline;
        EscrowState state;
        bytes32 termsHash;        // Hash of agreed terms
        Proof[] buyerProofs;
        Proof[] sellerProofs;
        bool buyerApproval;
        bool sellerApproval;
        uint256 disputeId;
        uint8 requiredProofs;
        mapping(address => bool) hasVoted;
    }
    
    struct Dispute {
        uint256 escrowId;
        uint256 createdAt;
        address initiator;
        string reason;
        uint8 buyerVotes;
        uint8 sellerVotes;
        bool resolved;
    }
    
    mapping(uint256 => Escrow) public escrows;
    mapping(uint256 => Dispute) public disputes;
    mapping(address => uint256[]) public userEscrows;
    
    uint256 public escrowCounter;
    uint256 public disputeCounter;
    uint256 public platformFee = 25; // 0.25%
    
    event EscrowCreated(uint256 indexed escrowId, address buyer, address seller);
    event EscrowFunded(uint256 indexed escrowId, uint256 amount);
    event ProofSubmitted(uint256 indexed escrowId, address submitter, ProofType proofType);
    event DisputeRaised(uint256 indexed escrowId, uint256 disputeId);
    event EscrowCompleted(uint256 indexed escrowId);
    event EscrowCancelled(uint256 indexed escrowId);
    
    // CREATE ESCROW
    function createEscrow(
        address _seller,
        uint256 _deadline,
        bytes32 _termsHash,
        uint8 _requiredProofs
    ) external payable nonReentrant returns (uint256) {
        require(msg.value > 0, "Must fund escrow");
        require(_seller != msg.sender, "Cannot escrow with self");
        require(_deadline > block.timestamp, "Invalid deadline");
        
        uint256 escrowId = escrowCounter++;
        Escrow storage newEscrow = escrows[escrowId];
        
        newEscrow.buyer = msg.sender;
        newEscrow.seller = _seller;
        newEscrow.amount = msg.value;
        newEscrow.createdAt = block.timestamp;
        newEscrow.deadline = _deadline;
        newEscrow.state = EscrowState.FUNDED;
        newEscrow.termsHash = _termsHash;
        newEscrow.requiredProofs = _requiredProofs;
        
        userEscrows[msg.sender].push(escrowId);
        userEscrows[_seller].push(escrowId);
        
        emit EscrowCreated(escrowId, msg.sender, _seller);
        emit EscrowFunded(escrowId, msg.value);
        
        return escrowId;
    }
    
    // SUBMIT PROOF (IPFS hash)
    function submitProof(
        uint256 _escrowId,
        bytes32 _contentHash,
        ProofType _proofType
    ) external {
        Escrow storage escrow = escrows[_escrowId];
        require(
            msg.sender == escrow.buyer || msg.sender == escrow.seller,
            "Not participant"
        );
        require(
            escrow.state == EscrowState.FUNDED || escrow.state == EscrowState.DELIVERED,
            "Invalid state"
        );
        
        Proof memory newProof = Proof({
            contentHash: _contentHash,
            proofType: _proofType,
            timestamp: block.timestamp,
            submitter: msg.sender,
            verified: false
        });
        
        if (msg.sender == escrow.buyer) {
            escrow.buyerProofs.push(newProof);
        } else {
            escrow.sellerProofs.push(newProof);
        }
        
        emit ProofSubmitted(_escrowId, msg.sender, _proofType);
    }
    
    // APPROVE COMPLETION
    function approveCompletion(uint256 _escrowId) external {
        Escrow storage escrow = escrows[_escrowId];
        require(
            msg.sender == escrow.buyer || msg.sender == escrow.seller,
            "Not participant"
        );
        require(escrow.state == EscrowState.FUNDED, "Invalid state");
        
        if (msg.sender == escrow.buyer) {
            escrow.buyerApproval = true;
        } else {
            escrow.sellerApproval = true;
        }
        
        // If both approved, release funds
        if (escrow.buyerApproval && escrow.sellerApproval) {
            _releaseFunds(_escrowId);
        }
    }
    
    // RAISE DISPUTE
    function raiseDispute(uint256 _escrowId, string calldata _reason) external {
        Escrow storage escrow = escrows[_escrowId];
        require(
            msg.sender == escrow.buyer || msg.sender == escrow.seller,
            "Not participant"
        );
        require(escrow.state == EscrowState.FUNDED, "Invalid state");
        
        escrow.state = EscrowState.DISPUTED;
        
        uint256 disputeId = disputeCounter++;
        disputes[disputeId] = Dispute({
            escrowId: _escrowId,
            createdAt: block.timestamp,
            initiator: msg.sender,
            reason: _reason,
            buyerVotes: 0,
            sellerVotes: 0,
            resolved: false
        });
        
        escrow.disputeId = disputeId;
        
        emit DisputeRaised(_escrowId, disputeId);
    }
    
    // ARBITER RESOLUTION (DAO/Multi-sig)
    function resolveDispute(
        uint256 _disputeId,
        bool _favorBuyer
    ) external onlyRole(ARBITER_ROLE) {
        Dispute storage dispute = disputes[_disputeId];
        require(!dispute.resolved, "Already resolved");
        
        Escrow storage escrow = escrows[dispute.escrowId];
        
        if (_favorBuyer) {
            // Refund buyer
            payable(escrow.buyer).transfer(escrow.amount);
        } else {
            // Pay seller
            _releaseFunds(dispute.escrowId);
        }
        
        dispute.resolved = true;
        escrow.state = EscrowState.RESOLVED;
    }
    
    // INTERNAL: Release funds with fee
    function _releaseFunds(uint256 _escrowId) internal {
        Escrow storage escrow = escrows[_escrowId];
        require(escrow.state != EscrowState.RESOLVED, "Already resolved");
        
        uint256 fee = (escrow.amount * platformFee) / 10000;
        uint256 payout = escrow.amount - fee;
        
        escrow.state = EscrowState.RESOLVED;
        
        payable(escrow.seller).transfer(payout);
        // Fee goes to treasury
        
        emit EscrowCompleted(_escrowId);
    }
    
    // TIMEOUT REFUND
    function claimTimeout(uint256 _escrowId) external {
        Escrow storage escrow = escrows[_escrowId];
        require(msg.sender == escrow.buyer, "Only buyer");
        require(block.timestamp > escrow.deadline, "Not expired");
        require(escrow.state == EscrowState.FUNDED, "Invalid state");
        
        escrow.state = EscrowState.CANCELLED;
        payable(escrow.buyer).transfer(escrow.amount);
        
        emit EscrowCancelled(_escrowId);
    }
}
